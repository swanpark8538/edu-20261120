<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boardDAO">

    <sql id="searchWhere">
        <if test="searchKeyword != null and searchKeyword != ''">
            <where>
                <choose>
                    <when test='searchCondition == "1"'>CONTENT</when>
                    <when test='searchCondition == "2"'>WRITER</when>
                    <otherwise>TITLE</otherwise>
                </choose>
                LIKE '%' || #{likeKeyword} || '%' ESCAPE '!'
            </where>
        </if>
    </sql>

    <select id="selectBoardList" parameterType="egovframework.example.board.service.BoardSearchVO"
            resultType="egovframework.example.board.service.BoardVO">
        SELECT BOARD_ID, TITLE, WRITER, ATCH_FILE_ID, REG_DT
          FROM BOARD
        <include refid="searchWhere"/>
         ORDER BY BOARD_ID DESC
        OFFSET #{firstIndex} ROWS FETCH NEXT #{recordCountPerPage} ROWS ONLY
    </select>

    <select id="selectBoardListCnt" parameterType="egovframework.example.board.service.BoardSearchVO"
            resultType="int">
        SELECT COUNT(*)
          FROM BOARD
        <include refid="searchWhere"/>
    </select>

    <select id="selectBoard" parameterType="string"
            resultType="egovframework.example.board.service.BoardVO">
        SELECT BOARD_ID, TITLE, CONTENT, WRITER, ATCH_FILE_ID, REG_DT
          FROM BOARD
         WHERE BOARD_ID = #{boardId}
    </select>

    <insert id="insertBoard" parameterType="egovframework.example.board.service.BoardVO">
        INSERT INTO BOARD (BOARD_ID, TITLE, CONTENT, WRITER, ATCH_FILE_ID)
        VALUES (#{boardId}, #{title}, #{content,jdbcType=VARCHAR}, #{writer}, #{atchFileId,jdbcType=VARCHAR})
    </insert>

    <update id="updateBoard" parameterType="egovframework.example.board.service.BoardVO">
        UPDATE BOARD
           SET TITLE = #{title},
               CONTENT = #{content,jdbcType=VARCHAR},
               WRITER = #{writer},
               ATCH_FILE_ID = #{atchFileId,jdbcType=VARCHAR}
         WHERE BOARD_ID = #{boardId}
    </update>

    <delete id="deleteBoard" parameterType="string">
        DELETE FROM BOARD WHERE BOARD_ID = #{boardId}
    </delete>
</mapper>
