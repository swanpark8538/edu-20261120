<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Board">
 <sql id="search"><if test="searchKeyword != null and searchKeyword != ''">WHERE
  <choose><when test='searchCondition == "1"'>CONTENT</when><when test='searchCondition == "2"'>WRITER</when><otherwise>TITLE</otherwise></choose>
  LIKE #{likeKeyword} ESCAPE '!'
 </if></sql>
 <select id="list" resultType="egovframework.board.service.Board">SELECT * FROM BOARD <include refid="search"/> ORDER BY CREATED_AT DESC, BOARD_ID DESC OFFSET #{offset} ROWS FETCH NEXT 10 ROWS ONLY</select>
 <select id="count" resultType="int">SELECT COUNT(*) FROM BOARD <include refid="search"/></select>
 <select id="get" resultType="egovframework.board.service.Board">SELECT * FROM BOARD WHERE BOARD_ID=#{id}</select>
 <insert id="add">INSERT INTO BOARD (BOARD_ID,TITLE,CONTENT,WRITER,ATCH_FILE_ID) VALUES (#{boardId},#{title},#{content},#{writer},#{atchFileId})</insert>
 <update id="edit">UPDATE BOARD SET TITLE=#{title}, CONTENT=#{content}, WRITER=#{writer} WHERE BOARD_ID=#{boardId}</update>
 <delete id="remove">DELETE FROM BOARD WHERE BOARD_ID=#{id}</delete>
 <select id="files" resultType="egovframework.board.service.Attachment">SELECT FILE_ID,BOARD_ID,ORIGINAL_NAME,STORED_NAME,FILE_SIZE FROM BOARD_FILE WHERE BOARD_ID=#{id} ORDER BY FILE_ID</select>
 <select id="file" resultType="egovframework.board.service.Attachment">SELECT FILE_ID,BOARD_ID,ORIGINAL_NAME,STORED_NAME,FILE_SIZE FROM BOARD_FILE WHERE FILE_ID=#{id}</select>
 <insert id="addFile">INSERT INTO BOARD_FILE VALUES (#{fileId},#{boardId},#{originalName},#{storedName},#{fileSize})</insert>
</mapper>
